{% extends 'base.html.twig' %}

{% block title %}Notre équipe - Grand Garage Hyundai{% endblock %}

{% block body %}

<!-- Page Header Start -->
<div class="container-fluid bg-primary py-5 bg-header"
     style="margin-bottom: 90px;">

    <div class="row py-5">

        <div class="col-12 pt-lg-5 mt-lg-5 text-center">

            <h1 class="display-4 text-white animated zoomIn">
                Notre équipe
            </h1>

            <a href="{{ path('home') }}"
               class="h5 text-white">
                Accueil
            </a>

            <i class="far fa-circle text-white px-2"></i>

            <span class="h5 text-white">
                Notre équipe
            </span>

        </div>

    </div>

</div>
<!-- Page Header End -->


<!-- Team Start -->
<div class="container-fluid py-5 wow fadeInUp"
     data-wow-delay="0.1s">

    <div class="container py-5">

        <!-- Section Title -->
        <div class="section-title text-center position-relative pb-3 mb-5 mx-auto"
             style="max-width: 700px;">

            <h5 class="fw-bold text-primary text-uppercase">
                Notre équipe
            </h5>

            <h1 class="mb-0">
                Des professionnels à votre service
            </h1>

            <p class="mt-3 mb-0">
                Découvrez notre équipe et notre engagement pour
                assurer l'entretien et la réparation de votre véhicule.
            </p>

        </div>


        <!-- Consultants -->
        <div class="row g-5">

            {% if consultants is defined and consultants|length > 0 %}

                {% for consultant in consultants %}

                    <div class="col-lg-4 col-md-6 wow fadeInUp"
                         data-wow-delay="{{ (loop.index0 % 3) * 0.2 }}s">

                        <div class="team-item bg-light rounded overflow-hidden h-100">

                            <!-- Photo -->
                            <div class="position-relative overflow-hidden">

                                {% if consultant.file is defined and consultant.file %}

                                    <img src="{{ asset('images/team/' ~ consultant.file) }}"
                                         alt="{{ consultant.nom }}"
                                         class="img-fluid w-100"
                                         style="height: 280px; object-fit: cover;">

                                {% else %}

                                    <div class="bg-secondary d-flex align-items-center justify-content-center"
                                         style="height: 280px;">

                                        <i class="fa fa-user fa-5x text-white"></i>

                                    </div>

                                {% endif %}

                            </div>


                            <!-- Informations -->
                            <div class="text-center p-4">

                                <h4 class="mb-1">
                                    {{ consultant.nom }}

                                    {% if consultant.pernon is defined and consultant.pernon %}
                                        {{ consultant.pernon }}
                                    {% endif %}
                                </h4>


                                {% if consultant.domaine is defined and consultant.domaine %}

                                    <small class="text-primary text-uppercase fw-bold">
                                        {{ consultant.domaine }}
                                    </small>

                                {% endif %}


                                {% if consultant.exprience is defined and consultant.exprience %}

                                    <p class="mt-3 mb-0">
                                        {{ consultant.exprience }}
                                    </p>

                                {% else %}

                                    <p class="mt-3 mb-0">
                                        Professionnel expérimenté au service
                                        de nos clients.
                                    </p>

                                {% endif %}

                            </div>

                        </div>

                    </div>

                {% endfor %}

            {% else %}

                <!-- Aucun membre -->
                <div class="col-12 text-center">

                    <div class="alert alert-info">

                        <i class="fa fa-info-circle me-2"></i>

                        Aucun membre de l'équipe n'est disponible
                        pour le moment.

                    </div>

                </div>

            {% endif %}

        </div>

    </div>

</div>
<!-- Team End -->


<!-- Team CTA Start -->
<div class="container-fluid py-5 bg-light">

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-8 text-center">

                <div class="section-title position-relative pb-3 mb-4">

                    <h5 class="fw-bold text-primary text-uppercase">
                        Grand Garage Hyundai
                    </h5>

                    <h2 class="mb-0">
                        Une équipe à votre écoute
                    </h2>

                </div>

                <p class="mb-4">
                    Notre équipe vous accompagne pour répondre à vos
                    besoins d'entretien, de diagnostic et de réparation.
                </p>

                <a href="{{ path('contact') }}"
                   class="btn btn-primary py-3 px-5">

                    Contactez-nous

                </a>

            </div>

        </div>

    </div>

</div>
<!-- Team CTA End -->

{% endblock %}