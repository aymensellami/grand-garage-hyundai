<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Welcome!{% endblock %} CLOUDMERGE</title>

    <!-- Favicon -->
    <link href="{{ asset('assets/img/favicon.ico') }}" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">

    <!-- Libraries Stylesheet -->
    <link rel="stylesheet" href="{{ asset('assets/lib/owlcarousel/assets/owl.carousel.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/lib/animate/animate.min.css') }}">

    <!-- Customized Bootstrap Stylesheet -->
    <link rel="stylesheet" href="{{ asset('assets/css/bootstrap.min.css') }}">

    <!-- Template Stylesheet -->
    {% block stylesheets %}
        <!-- Add any additional stylesheets specific to a page if needed -->
    {% endblock %}
    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('assets/lib/wow/wow.min.js') }}" defer></script>
    <script src="{{ asset('assets/lib/easing/easing.min.js') }}" defer></script>
    <script src="{{ asset('assets/lib/waypoints/waypoints.min.js') }}" defer></script>
    <script src="{{ asset('assets/lib/counterup/counterup.min.js') }}" defer></script>
    <script src="{{ asset('assets/lib/owlcarousel/owl.carousel.min.js') }}" defer></script>

    <!-- Template Javascript -->
    {% block javascripts %}
        <!-- Add any additional scripts specific to a page if needed -->
    {% endblock %}
    <script src="{{ asset('assets/js/main.js') }}" defer></script>
</head>
<body>
    {% include "_partials/_nav.html.twig" %}
    <section class="s-bricks">

    {% block body %} {% endblock %}
        </section>

    {% include "_partials/_footer.html.twig" %}

</body>
</html>