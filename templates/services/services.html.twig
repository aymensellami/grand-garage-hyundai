{% extends 'base.html.twig' %}

{% block title %}Services - Grand Garage Hyundai{% endblock %}

{% block body %}

<!-- Page Header Start -->
<div class="container-fluid bg-primary py-5 bg-header"
     style="margin-bottom: 90px;">

    <div class="row py-5">

        <div class="col-12 pt-lg-5 mt-lg-5 text-center">

            <h1 class="display-4 text-white animated zoomIn">
                Nos services
            </h1>

            <a href="{{ path('home') }}"
               class="h5 text-white">
                Accueil
            </a>

            <i class="far fa-circle text-white px-2"></i>

            <span class="h5 text-white">
                Services
            </span>

        </div>

    </div>

</div>
<!-- Page Header End -->


<!-- Services Start -->
<div class="container-fluid py-5 wow fadeInUp"
     data-wow-delay="0.1s">

    <div class="container py-5">

        <!-- Section Title -->
        <div class="section-title text-center position-relative pb-3 mb-5 mx-auto"
             style="max-width: 700px;">

            <h5 class="fw-bold text-primary text-uppercase">
                Nos services
            </h5>

            <h1 class="mb-0">
                Des solutions professionnelles pour votre véhicule
            </h1>

            <p class="mt-3 mb-0">
                Grand Garage Hyundai vous accompagne dans l'entretien,
                le diagnostic et la réparation de votre véhicule.
            </p>

        </div>


        <!-- Services List -->
        <div class="row g-5">

            {% if domaineExpertises is defined and domaineExpertises|length > 0 %}

                {% for domaineExpertise in domaineExpertises %}

                    <div class="col-lg-4 col-md-6 wow fadeInUp"
                         data-wow-delay="{{ (loop.index0 % 3) * 0.2 }}s">

                        <div class="service-item bg-light rounded h-100">

                            <!-- Image -->
                            <div class="position-relative overflow-hidden rounded-top">

                                {% if domaineExpertise.file is defined and domaineExpertise.file %}

                                    <img src="{{ asset('images/team/' ~ domaineExpertise.file) }}"
                                         alt="{{ domaineExpertise.nom }}"
                                         class="img-fluid w-100"
                                         style="height: 220px; object-fit: cover;">

                                {% else %}

                                    <div class="bg-secondary d-flex align-items-center justify-content-center"
                                         style="height: 220px;">

                                        <i class="fa fa-car fa-4x text-white"></i>

                                    </div>

                                {% endif %}

                            </div>


                            <!-- Content -->
                            <div class="p-4 text-center">

                                <div class="d-inline-flex align-items-center justify-content-center bg-primary rounded-circle mb-4"
                                     style="width: 60px; height: 60px;">

                                    <i class="fa fa-car text-white fa-lg"></i>

                                </div>


                                <h4 class="mb-3">
                                    {{ domaineExpertise.nom }}
                                </h4>


                                {% if domaineExpertise.description %}

                                    <p class="mb-4">
                                        {{ domaineExpertise.description }}
                                    </p>

                                {% else %}

                                    <p class="mb-4">
                                        Découvrez notre service automobile
                                        et bénéficiez d'un accompagnement
                                        professionnel.
                                    </p>

                                {% endif %}


                                <a href="{{ path('contact') }}"
                                   class="btn btn-primary py-2 px-4">

                                    Demander un service

                                </a>

                            </div>

                        </div>

                    </div>

                {% endfor %}

            {% else %}

                <!-- Aucun service -->
                <div class="col-12 text-center">

                    <div class="alert alert-info">

                        <i class="fa fa-info-circle me-2"></i>

                        Aucun service n'est disponible pour le moment.

                    </div>

                </div>

            {% endif %}

        </div>

    </div>

</div>
<!-- Services End -->


<!-- Why Choose Us Start -->
<div class="container-fluid py-5 bg-light">

    <div class="container py-5">

        <div class="section-title text-center position-relative pb-3 mb-5">

            <h5 class="fw-bold text-primary text-uppercase">
                Pourquoi choisir Grand Garage Hyundai ?
            </h5>

            <h1 class="mb-0">
                Un service automobile de qualité
            </h1>

        </div>


        <div class="row g-5">

            <!-- Expertise -->
            <div class="col-lg-4 col-md-6 wow zoomIn"
                 data-wow-delay="0.2s">

                <div class="bg-white rounded p-5 text-center h-100">

                    <div class="bg-primary rounded d-inline-flex align-items-center justify-content-center mb-4"
                         style="width: 65px; height: 65px;">

                        <i class="fa fa-tools text-white fa-2x"></i>

                    </div>

                    <h4 class="mb-3">
                        Expertise
                    </h4>

                    <p class="mb-0">
                        Une équipe professionnelle pour prendre soin
                        de votre véhicule.
                    </p>

                </div>

            </div>


            <!-- Diagnostic -->
            <div class="col-lg-4 col-md-6 wow zoomIn"
                 data-wow-delay="0.4s">

                <div class="bg-white rounded p-5 text-center h-100">

                    <div class="bg-primary rounded d-inline-flex align-items-center justify-content-center mb-4"
                         style="width: 65px; height: 65px;">

                        <i class="fa fa-cogs text-white fa-2x"></i>

                    </div>

                    <h4 class="mb-3">
                        Diagnostic
                    </h4>

                    <p class="mb-0">
                        Des solutions adaptées pour identifier les
                        problèmes de votre véhicule.
                    </p>

                </div>

            </div>


            <!-- Satisfaction -->
            <div class="col-lg-4 col-md-6 wow zoomIn"
                 data-wow-delay="0.6s">

                <div class="bg-white rounded p-5 text-center h-100">

                    <div class="bg-primary rounded d-inline-flex align-items-center justify-content-center mb-4"
                         style="width: 65px; height: 65px;">

                        <i class="fa fa-check-circle text-white fa-2x"></i>

                    </div>

                    <h4 class="mb-3">
                        Satisfaction
                    </h4>

                    <p class="mb-0">
                        Nous mettons la satisfaction de nos clients
                        au centre de notre travail.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Why Choose Us End -->


<!-- Call To Action Start -->
<div class="container-fluid py-5">

    <div class="container py-5">

        <div class="bg-primary rounded p-5 text-center">

            <h2 class="text-white mb-3">
                Besoin d'un entretien ou d'une réparation ?
            </h2>

            <p class="text-white mb-4">
                Contactez Grand Garage Hyundai pour prendre rendez-vous
                ou obtenir plus d'informations sur nos services.
            </p>

            <a href="{{ path('contact') }}"
               class="btn btn-dark py-3 px-5">

                Contactez-nous

            </a>

        </div>

    </div>

</div>
<!-- Call To Action End -->

{% endblock %}