{% for entreprise in entreprises %}
        <!-- Facts Start -->
<div class="container-fluid facts py-5 pt-lg-0">
    <div class="container py-5 pt-lg-0">
        <div class="row gx-0">

            <!-- Équipe -->
            <div class="col-lg-4 wow zoomIn" data-wow-delay="0.1s">
                <div class="bg-primary shadow d-flex align-items-center justify-content-center p-4"
                     style="height: 150px;">

                    <div class="bg-white d-flex align-items-center justify-content-center rounded mb-2"
                         style="width: 60px; height: 60px;">
                        <i class="fa fa-users text-primary"></i>
                    </div>

                    <div class="ps-4">
                        <h5 class="text-white mb-0">
                            Équipe professionnelle
                        </h5>

                        <h1 class="text-white mb-0"
                            data-toggle="counter-up">
                            {{ entreprise.nbrConsultant }}
                        </h1>
                    </div>
                </div>
            </div>

            <!-- Chiffre d'affaires -->
            <div class="col-lg-4 wow zoomIn" data-wow-delay="0.3s">
                <div class="bg-light shadow d-flex align-items-center justify-content-center p-4"
                     style="height: 150px;">

                    <div class="bg-primary d-flex align-items-center justify-content-center rounded mb-2"
                         style="width: 60px; height: 60px;">
                        <i class="fa fa-car text-white"></i>
                    </div>

                    <div class="ps-4">
                        <h5 class="text-primary mb-0">
                            Notre expertise
                        </h5>

                        <h5 class="mb-3">
                            {{ entreprise.chiffredaffaires }}
                        </h5>
                    </div>
                </div>
            </div>

            <!-- Service -->
            <div class="col-lg-4 wow zoomIn" data-wow-delay="0.5s">
                <div class="bg-primary shadow d-flex align-items-center justify-content-center p-4"
                     style="height: 150px;">

                    <div class="bg-white d-flex align-items-center justify-content-center rounded mb-2"
                         style="width: 60px; height: 60px;">
                        <i class="fa fa-wrench text-primary"></i>
                    </div>

                    <div class="ps-4">
                        <h5 class="text-white mb-0">
                            Service automobile
                        </h5>

                        <h5 class="text-white mb-3">
                            Hyundai
                        </h5>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- Facts End -->


<!-- Enterprise Introduction Start -->
<div class="container-fluid py-5 wow fadeInUp"
     data-wow-delay="0.1s">

    <div class="container py-5">

        <div class="row g-5 align-items-center">

            <!-- Texte -->
            <div class="col-lg-7">

                <div class="section-title position-relative pb-3 mb-5">

                    <h5 class="fw-bold text-primary text-uppercase">
                        À propos de nous
                    </h5>

                    <h1 class="mb-0">
                        Grand Garage Hyundai
                    </h1>

                </div>

                <h3 class="mb-3">
                    {{ entreprise.nom }}
                </h3>

                <p class="mb-4">
                    {{ entreprise.introduction }}
                </p>

               

                <div class="d-flex align-items-center mt-4">

                    <a href="{{ path('about') }}"
                       class="btn btn-primary py-3 px-5 me-3">
                        En savoir plus
                    </a>

                    <a href="{{ path('contact') }}"
                       class="btn btn-outline-primary py-3 px-5">
                        Nous contacter
                    </a>

                </div>

            </div>


            <!-- Image -->
            <div class="col-lg-5">

                <div class="position-relative h-100">

                    <img class="img-fluid rounded wow zoomIn"
                         data-wow-delay="0.5s"
                         src="{{ asset('assets/img/about.jpg') }}"
                         alt="Grand Garage Hyundai">

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Enterprise Introduction End -->
    {% endfor %}